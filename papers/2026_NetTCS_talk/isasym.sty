%% isasym.sty -- typeset Isabelle Unicode symbols in text and in listings
%%
%% Each symbol is defined once: \newunicodechar (running text, math)
%% plus a matching entry for the listings `literate` key.
%% Symbol table generated from Isabelle's etc/symbols and
%% lib/texinputs/isabellesym.sty (Isabelle mirror, master).
%%
%% Usage:
%%   \usepackage{isasym}
%%   optional extras/overrides (preamble):
%%     \isasym[width]{⊛}{\circledast}    math symbol
%%     \isasymtext[width]{x}{replacement} text replacement
%%     \isalit[width]{==>}{\ensuremath{\Longrightarrow}}  listings only
%%     \isasubs{xyz} / \isasups{xyz}     more ⇩x / ⇧x listing entries
%%   The literate list is installed automatically at \begin{document}
%%   (call \isaapplyliterate to do it earlier). It replaces any other
%%   `literate=` setting, so do not set literate yourself.
%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{isasym}[2026/11/25 Isabelle symbols for text and listings]

\RequirePackage{iftex}
\ifPDFTeX
  \RequirePackage[utf8]{inputenc}
  \RequirePackage[T1]{fontenc}   % \guilsinglleft/right (cartouches)
\else
  \@ifpackageloaded{fontspec}{}{\RequirePackage{fontspec}}
\fi
\RequirePackage{amsmath}
\RequirePackage{amssymb}         % \mathbb, \mathfrak, \Box, \lozenge, ...
\RequirePackage{stmaryrd}        % \llbracket, \fatsemi, \interleave, ...
\RequirePackage{textcomp}
\RequirePackage{pifont}          % \ding (check/cross marks)
\RequirePackage{eurosym}         % \euro
\RequirePackage{newunicodechar}
\RequirePackage{listings}

%% ---------------------------------------------------------------
%% machinery
\newcommand\isa@lits{}
\newcommand\isa@addlit[3]{\g@addto@macro\isa@lits{{#1}{{#2}}#3}}
\newcommand\isa@def[3][1]{%
  \newunicodechar{#2}{#3}%
  \isa@addlit{#2}{#3}{#1}}

\newcommand\isasym[3][1]{\isa@def[#1]{#2}{\ensuremath{#3}}}
\newcommand\isasymtext[3][1]{\isa@def[#1]{#2}{#3}}
\newcommand\isalit[3][1]{\isa@addlit{#2}{#3}{#1}}

\newcommand\isasubs[1]{\@tfor\isa@x:=#1\do{%
  \expandafter\isa@sub\expandafter{\isa@x}}}
\newcommand\isa@sub[1]{\isa@addlit{⇩#1}{${}_{#1}$}{1}}
\newcommand\isasups[1]{\@tfor\isa@x:=#1\do{%
  \expandafter\isa@sup\expandafter{\isa@x}}}
\newcommand\isa@sup[1]{\isa@addlit{⇧#1}{${}^{#1}$}{1}}

\newcommand\isaapplyliterate{%
  \edef\isa@tmp{\noexpand\lstset{literate=\unexpanded\expandafter{\isa@lits}}}%
  \isa@tmp}
\AtBeginDocument{\isaapplyliterate}
\lstset{extendedchars=true}

\ifPDFTeX\def\isa@cedilla{\c\relax}\else\def\isa@cedilla{\char"00B8\relax}\fi

%% Z-notation helpers (from isabellesym.sty)
\newcommand{\isa@Zhbar}[1]{\rlap{\raise.0001ex\hbox{\ensuremath{-}}}#1}
\newcommand{\isa@Zpvbar}[1]{\ooalign{\hfil\ensuremath{\mapstochar\mkern 5mu}\hfil\cr#1}}
\newcommand{\isa@Zfvbar}[1]{\ooalign{\hfil\ensuremath{\mapstochar\mkern 3mu\mapstochar\mkern 5mu}\hfil\cr#1}}
\newcommand{\isa@Zdarrow}[3]{\ooalign{\ensuremath{#1}\hfil\cr\ensuremath{\mkern#3mu\ensuremath{#2}}}}

%% ---------------------------------------------------------------
%% control symbols
%%   ⇩x  ⇧x  : sub/superscript of the next character
%%   ❙x      : bold next character
%%   ⇘…⇙  ⇗…⇖ : sub/superscript blocks
\newunicodechar{⇩}{\textsubscript}
\newunicodechar{⇧}{\textsuperscript}
\newunicodechar{❙}{\textbf}
\newcommand\isa@bsub{\leavevmode\lower0.5ex\hbox\bgroup\fontsize\sf@size\z@\selectfont}
\newcommand\isa@bsup{\leavevmode\raise1ex\hbox\bgroup\fontsize\sf@size\z@\selectfont}
\newunicodechar{⇘}{\isa@bsub}
\newunicodechar{⇙}{\egroup}
\newunicodechar{⇗}{\isa@bsup}
\newunicodechar{⇖}{\egroup}
\isasubs{0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ'*+-}
\isasups{0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ'*+-}

%% ASCII notations in listings
\isalit{=>}{\ensuremath{\Rightarrow}}
\isalit[2]{==>}{\ensuremath{\Longrightarrow}}
\isalit{-->}{\ensuremath{\longrightarrow}}

%% non-Isabelle typography that shows up in Isabelle-adjacent text
\isa@def{’}{'}
\isa@def{–}{\textendash}

